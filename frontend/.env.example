# Mosaic Aggregator API Key
NEXT_PUBLIC_MOSAIC_API_KEY=

# Privy Configuration
# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=""

# Optional: App Client ID for multi-environment setup
# Learn more: https://docs.privy.io/basics/react/setup
NEXT_PUBLIC_PRIVY_CLIENT_ID=""



# Get this from https://dashboard.privy.io -> Settings -> API Keys
PRIVY_APP_SECRET=

# CopilotKit Configuration
# Option 1: Use Copilot Cloud (Recommended)
NEXT_PUBLIC_COPILOTKIT_API_KEY=""

# Option 2: Use Self-hosted Runtime (uncomment if using self-hosted)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit

FACILITATOR_PRIVATE_KEY=facilitator_private_key

# MovePosition / Movement Network Configuration
NEXT_PUBLIC_MOVEMENT_API_BASE=https://api.moveposition.xyz
NEXT_PUBLIC_MOVEPOSITION_ADDRESS=0xccd2621d2897d407e06d18e6ebe3be0e6d9b61f1e809dd49360522b9105812cf
NEXT_PUBLIC_APTOS_NETWORK_SHORT=mainnet
NEXT_PUBLIC_MOVEMENT_CHAIN_ID=126
NEXT_PUBLIC_MOVEMENT_LABS_URL=https://mainnet.movementnetwork.xyz/v1
NEXT_PUBLIC_MOVEMENT_EXPLORER_URL=https://explorer.movementlabs.xyz 


# Movement Network Configuration
# RPC endpoint for Movement Network mainnet
# Used by API routes for blockchain queries
